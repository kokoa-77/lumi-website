/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Versioned files never change once published. One placeholder plus one splat: the old
# `/download/v*/*` pattern (two splats) was silently ignored by Cloudflare Pages.
# No Content-Disposition: .exe/.zip already download by type, and SHA256SUMS.txt stays readable inline.
/download/:version/*
  Cache-Control: public, max-age=31536000, immutable

/download/latest.json
  Cache-Control: public, max-age=300
  Content-Type: application/json; charset=utf-8
