---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import type { Locale } from "../data/site";
import { localizedPath } from "../data/site";
import "../styles/global.css";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  routePath: string;
  noindex?: boolean;
}

const { locale, title, description, routePath, noindex = false } = Astro.props;
const siteOrigin = (Astro.site?.toString() || "https://lumilauncher.pages.dev").replace(/\/+$/, "");

const canonicalPath = localizedPath(locale, routePath);
const enPath = localizedPath("en", routePath);
const zhPath = localizedPath("zh", routePath);

const canonicalUrl = `${siteOrigin}${canonicalPath}`;
const enUrl = `${siteOrigin}${enPath}`;
const zhUrl = `${siteOrigin}${zhPath}`;
const ogImageUrl = `${siteOrigin}/og-card.png`;
---

<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : "en"} data-theme="light" data-fx="rich">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={locale === "zh" ? "Lumi 更新日志 RSS" : "Lumi Launcher Changelog RSS"}
      href={locale === "zh" ? "/zh/rss.xml" : "/rss.xml"}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lumi Launcher" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline>
      (() => {
        try {
          const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          const lowSpec =
            reduced ||
            (typeof navigator.hardwareConcurrency === "number" &&
              navigator.hardwareConcurrency <= 4) ||
            Boolean(navigator.connection && navigator.connection.saveData);
          if (lowSpec) {
            document.documentElement.dataset.fx = "lite";
          }
          if (!reduced) {
            document.documentElement.classList.add("lumi-js");
          }
          const saved = localStorage.getItem("lumi-theme");
          if (saved === "dark" || saved === "light") {
            document.documentElement.dataset.theme = saved;
          }
        } catch {
          // Storage unavailable; keep default daylight theme
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header locale={locale} routePath={routePath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
