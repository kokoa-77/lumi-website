---
import { Picture } from "astro:assets";
import enHomeDark from "../assets/screenshots/en/01-home-dark.png";
import enHomeLight from "../assets/screenshots/en/01-home-light.png";
import enInstancesLight from "../assets/screenshots/en/02-instances-light.png";
import enDetailLight from "../assets/screenshots/en/03-detail-light.png";
import enDiscoverLight from "../assets/screenshots/en/04-discover-light.png";
import enSyncLight from "../assets/screenshots/en/05-sync-light.png";
import shotBanner from "../assets/screenshots/social-preview.png";
import zhHomeDark from "../assets/screenshots/zh/01-home-dark.png";
import zhHomeLight from "../assets/screenshots/zh/01-home-light.png";
import zhInstancesLight from "../assets/screenshots/zh/02-instances-light.png";
import zhDetailLight from "../assets/screenshots/zh/03-detail-light.png";
import zhDiscoverLight from "../assets/screenshots/zh/04-discover-light.png";
import zhSyncLight from "../assets/screenshots/zh/05-sync-light.png";
import { getDict } from "../data/i18n";
import type { Locale } from "../data/site";
import { LINKS } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isZh = locale === "zh";
const t = getDict(locale);
const p = t.press;
const d = t.download;

const shots = [
  { src: shotBanner, label: "Brand Banner (1280×640)" },
  { src: isZh ? zhHomeLight : enHomeLight, label: isZh ? "浅色沉浸世界首页" : "Light World Home" },
  { src: isZh ? zhHomeDark : enHomeDark, label: isZh ? "暗夜沉浸世界首页" : "Night World Home" },
  {
    src: isZh ? zhInstancesLight : enInstancesLight,
    label: isZh ? "浅色实例库" : "Light Instance Library",
  },
  {
    src: isZh ? zhDetailLight : enDetailLight,
    label: isZh ? "实例内容与回滚" : "Instance Content & Rollback",
  },
  {
    src: isZh ? zhDiscoverLight : enDiscoverLight,
    label: isZh ? "统一资源发现" : "Unified Discover",
  },
  { src: isZh ? zhSyncLight : enSyncLight, label: isZh ? "本机跨实例同步" : "Local Instance Sync" },
];
---

<section class="lumi-sky pb-10 pt-12 sm:pt-16">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <h1 class="text-3xl font-extrabold tracking-tight text-[var(--fg)] sm:text-5xl">{p.title}</h1>
    <p class="mt-3 max-w-2xl text-base text-[var(--fg-muted)]">{p.subtitle}</p>
  </div>
</section>

<section class="mx-auto max-w-5xl space-y-8 px-4 py-10 sm:px-6">
  <!-- 100-word blurb -->
  <div class="lumi-panel p-6 sm:p-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-xl font-bold text-[var(--fg)]">{p.blurbTitle}</h2>
      <button
        type="button"
        data-copy-text={p.blurbText}
        data-copy-label={d.copyBtn}
        data-copied-label={d.copiedBtn}
        class="lumi-pill cursor-pointer border border-[var(--line)] bg-[var(--surface-2)] px-4 py-1.5 text-xs font-semibold text-[var(--fg)] hover:bg-[var(--surface-hover)]"
      >
        {d.copyBtn}
      </button>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-[var(--fg-muted)] sm:text-base">{p.blurbText}</p>
  </div>

  <!-- Quick Facts -->
  <div class="lumi-panel p-6 sm:p-8">
    <h2 class="text-xl font-bold text-[var(--fg)]">{p.factsTitle}</h2>
    <dl class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        p.facts.map((item) => (
          <div class="lumi-panel-soft p-4">
            <dt class="text-xs font-semibold text-[var(--accent)]">{item.label}</dt>
            <dd class="mt-1 text-sm font-medium text-[var(--fg)]">{item.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <!-- Brand Guidelines (60fps recording archive will be added after Mojang AppID approval) -->
  <div class="lumi-panel flex flex-col justify-between gap-4 p-6 sm:flex-row sm:items-center sm:p-8">
    <div class="max-w-2xl">
      <h2 class="text-lg font-bold text-[var(--fg)]">{p.brandTitle}</h2>
      <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">{p.brandDesc}</p>
    </div>
    <div class="shrink-0">
      <a
        href={locale === "zh" ? LINKS.trademarkZh : LINKS.trademark}
        target="_blank"
        rel="noopener noreferrer"
        class="lumi-pill inline-flex items-center gap-2 border border-[var(--line)] bg-[var(--surface-2)] px-5 py-2.5 text-sm font-semibold text-[var(--fg)] no-underline hover:bg-[var(--surface-hover)]"
      >
        {p.brandBtn} ↗
      </a>
    </div>
  </div>

  <!-- Official Screenshots Gallery -->
  <div class="lumi-panel p-6 sm:p-8">
    <h2 class="text-xl font-bold text-[var(--fg)]">
      {locale === "zh" ? "高清实机截图预览" : "Official Screenshots"}
    </h2>
    <div class="mt-5 grid gap-5 sm:grid-cols-2">
      {
        shots.map((shot) => (
          <figure class="lumi-panel-soft overflow-hidden">
            <Picture
              src={shot.src}
              alt={shot.label}
              widths={[640, 1280, 1920]}
              sizes="(max-width: 640px) 100vw, 480px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              loading="lazy"
              class="block h-auto w-full"
            />
            <figcaption class="px-3.5 py-2.5 text-xs font-medium text-[var(--fg-muted)]">
              {shot.label}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    for (const btn of document.querySelectorAll("[data-copy-text]")) {
      btn.addEventListener("click", async () => {
        const text = btn.getAttribute("data-copy-text");
        if (!text) return;
        const copyLabel = btn.getAttribute("data-copy-label") || "Copy";
        const copiedLabel = btn.getAttribute("data-copied-label") || "Copied";
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = copiedLabel;
          setTimeout(() => {
            btn.textContent = copyLabel;
          }, 1800);
        } catch {
          // ignore
        }
      });
    }
  })();
</script>
