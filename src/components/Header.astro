---
import { getDict } from "../data/i18n";
import type { Locale } from "../data/site";
import { getReleases, localizedPath, primaryDownloadHref } from "../data/site";

interface Props {
  locale: Locale;
  routePath: string;
}

const { locale, routePath } = Astro.props;
const t = getDict(locale);
const isZh = locale === "zh";
const otherLocale: Locale = isZh ? "en" : "zh";
const otherHref = localizedPath(otherLocale, routePath);
const zhHref = localizedPath("zh", routePath);
const homeHref = localizedPath(locale, "/");
const demoHref = localizedPath(locale, "/demo");
const changelogHref = localizedPath(locale, "/changelog");

const { latest } = getReleases();
const directInstallerHref = primaryDownloadHref(latest.installer, latest.htmlUrl);
const installerName = latest.installer?.name || "LumiLauncher_0.7.0_x64-setup.exe";

const isHome = routePath === "/";
const featuresHref = isHome ? "#features" : `${homeHref}#features`;
const migrationHref = isHome ? "#migration" : `${homeHref}#migration`;
const downloadAnchorHref = isHome ? "#download" : `${homeHref}#download`;

const navLinks = [
  { label: isZh ? "功能" : "Features", href: featuresHref, active: false },
  { label: isZh ? "搬家" : "Migrate", href: migrationHref, active: false },
  { label: isZh ? "下载" : "Download", href: downloadAnchorHref, active: false },
  { label: isZh ? "在线试玩" : "Live Demo", href: demoHref, active: routePath === "/demo" },
  { label: t.nav.changelog, href: changelogHref, active: routePath === "/changelog" },
];
---

{
  locale === "en" && (
    <div
      id="lumi-zh-banner"
      hidden
      class="relative z-[60] border-b border-[var(--line)] bg-[var(--surface-2)] text-xs text-[var(--fg)]"
    >
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-2">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="text-[var(--fg-muted)]">{t.nav.zhBannerText}</span>
          <a
            href={zhHref}
            data-lang-switch="zh"
            class="lumi-pill inline-flex items-center bg-[var(--accent)] px-3 py-0.5 text-xs font-semibold text-[var(--on-accent)] no-underline hover:bg-[var(--accent-hover)]"
          >
            {t.nav.zhBannerAction}
          </a>
        </div>
        <button
          type="button"
          data-zh-dismiss
          aria-label={t.nav.zhBannerClose}
          class="lumi-pill inline-flex h-6 w-6 cursor-pointer items-center justify-center text-[var(--fg-muted)] hover:bg-[var(--surface-hover)] hover:text-[var(--fg)]"
        >
          ✕
        </button>
      </div>
    </div>
  )
}

<header class="sticky top-3 z-50 mx-auto w-full max-w-5xl px-3 sm:px-5">
  <div class="lumi-floating-nav flex h-14 items-center justify-between gap-3 rounded-full px-3 sm:px-4">
    <a
      href={homeHref}
      class="group inline-flex shrink-0 items-center gap-2.5 pl-1 text-[var(--fg)] no-underline"
    >
      <img
        src="/favicon.svg"
        alt="Lumi"
        width="30"
        height="30"
        class="h-7.5 w-7.5 rounded-lg shadow-xs transition-transform duration-200 group-hover:scale-105"
      />
      <span class="text-sm font-extrabold tracking-tight sm:text-base">Lumi</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-0.5 md:flex">
      {
        navLinks.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? "page" : undefined}
            class:list={[
              "lumi-pill px-3.5 py-1.5 text-[13px] font-medium no-underline",
              item.active
                ? "bg-[var(--accent-soft)] text-[var(--accent)] font-semibold"
                : "text-[var(--fg-muted)] hover:bg-[var(--surface-hover)] hover:text-[var(--fg)]",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-1.5">
      <a
        href={otherHref}
        data-lang-switch={otherLocale}
        title={t.nav.switchLangLabel}
        aria-label={`${t.nav.switchLangShort} (${t.nav.switchLangLabel})`}
        class="lumi-pill inline-flex h-8.5 items-center px-2.5 text-xs font-semibold text-[var(--fg-muted)] no-underline hover:bg-[var(--surface-hover)] hover:text-[var(--fg)]"
      >
        {t.nav.switchLangShort}
      </a>

      <button
        type="button"
        id="lumi-theme-toggle"
        aria-label={t.nav.themeToggle}
        class="lumi-pill inline-flex h-8.5 w-8.5 cursor-pointer items-center justify-center text-[var(--fg-muted)] hover:bg-[var(--surface-hover)] hover:text-[var(--fg)]"
      >
        <svg
          class="h-4 w-4 [html[data-theme='dark']_&]:hidden"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <svg
          class="hidden h-4 w-4 [html[data-theme='dark']_&]:block"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8" />
          <path
            d="M12 2.5v2.2M12 19.3v2.2M4.7 4.7l1.6 1.6M17.7 17.7l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.7 19.3l1.6-1.6M17.7 6.3l1.6-1.6"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>
      </button>

      {
        latest.kind === "prereview" ? (
          <a
            href={downloadAnchorHref}
            class="lumi-pill hidden h-8.5 items-center gap-1.5 bg-[var(--accent)] px-3.5 text-xs font-semibold text-[var(--on-accent)] no-underline hover:bg-[var(--accent-hover)] md:inline-flex"
          >
            <span>{isZh ? "预审下载" : "Pre-review"}</span>
          </a>
        ) : (
          <a
            href={directInstallerHref}
            download={installerName}
            data-direct-download={installerName}
            class="lumi-pill hidden h-8.5 items-center gap-1.5 bg-[var(--accent)] px-3.5 text-xs font-semibold text-[var(--on-accent)] no-underline hover:bg-[var(--accent-hover)] md:inline-flex"
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 4v11m0 0 4-4m-4 4-4-4M5 19h14"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span>{isZh ? "立即下载" : "Download"}</span>
          </a>
        )
      }
      <a
        href={downloadAnchorHref}
        class="lumi-pill inline-flex h-8.5 items-center gap-1 bg-[var(--accent)] px-3 text-xs font-semibold text-[var(--on-accent)] no-underline hover:bg-[var(--accent-hover)] md:hidden"
      >
        <span>{isZh ? "电脑下载" : "PC Build"}</span>
      </a>
    </div>
  </div>

  {/* 手机端导航胶囊 */}
  <nav
    aria-label="Mobile"
    class="lumi-floating-nav lumi-no-scrollbar mt-2 flex items-center justify-between gap-1 overflow-x-auto rounded-full px-2 py-1 text-xs font-medium md:hidden"
  >
    {
      navLinks.map((item) => (
        <a
          href={item.href}
          class:list={[
            "lumi-pill shrink-0 px-3 py-1 no-underline",
            item.active
              ? "bg-[var(--accent-soft)] text-[var(--accent)] font-semibold"
              : "text-[var(--fg-muted)] hover:text-[var(--fg)]",
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

{/* 开始下载时的提示 */}
<div
  id="lumi-download-toast"
  hidden
  role="status"
  aria-live="polite"
  class="lumi-glass fixed bottom-5 right-5 z-50 max-w-sm rounded-2xl p-4 text-xs shadow-xl"
>
  <div class="flex items-start justify-between gap-3">
    <div class="space-y-1">
      <p class="font-bold text-[var(--fg)]">
        {isZh ? "已开始下载 Lumi 安装程序" : "Downloading Lumi Installer"}
      </p>
      <p class="leading-relaxed text-[var(--fg-muted)]">
        {
          isZh
            ? "首次打开如遇 SmartScreen 提醒，点「更多信息 → 仍要运行」即可。"
            : "If SmartScreen prompts on first run, click More info → Run anyway."
        }
      </p>
      <a
        href={downloadAnchorHref}
        data-toast-close
        class="inline-block pt-1 font-semibold text-[var(--accent)] no-underline hover:underline"
      >
        {isZh ? "查看 SmartScreen 两步安装指引 →" : "SmartScreen 2-step guide →"}
      </a>
    </div>
    <button
      type="button"
      data-toast-close
      aria-label={isZh ? "关闭" : "Close"}
      class="lumi-pill inline-flex h-6 w-6 shrink-0 cursor-pointer items-center justify-center text-[var(--fg-muted)] hover:bg-[var(--surface-hover)] hover:text-[var(--fg)]"
    >
      ✕
    </button>
  </div>
</div>

<script is:inline>
  (() => {
    const toggle = document.getElementById("lumi-theme-toggle");
    if (toggle) {
      toggle.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("lumi-theme", next);
        } catch {
          // 浏览器禁用本地存储时忽略
        }
      });
    }

    for (const el of document.querySelectorAll("[data-lang-switch]")) {
      el.addEventListener("click", () => {
        try {
          const targetLang = el.getAttribute("data-lang-switch");
          if (targetLang === "en" || targetLang === "zh") {
            localStorage.setItem("lumi-lang", targetLang);
          }
        } catch {
          // 浏览器禁用本地存储时忽略
        }
      });
    }

    const banner = document.getElementById("lumi-zh-banner");
    if (banner) {
      try {
        const dismissed = localStorage.getItem("lumi-lang-banner-dismissed");
        const savedLang = localStorage.getItem("lumi-lang");
        const prefersZh = (navigator.language || "").toLowerCase().startsWith("zh");
        if (prefersZh && !dismissed && savedLang !== "en") banner.hidden = false;
      } catch {
        // 浏览器禁用本地存储时忽略
      }
      banner.querySelector("[data-zh-dismiss]")?.addEventListener("click", () => {
        banner.hidden = true;
        try {
          localStorage.setItem("lumi-lang-banner-dismissed", "1");
        } catch {
          // 浏览器禁用本地存储时忽略
        }
      });
    }

    const toast = document.getElementById("lumi-download-toast");
    let toastTimer = null;
    if (toast) {
      for (const el of document.querySelectorAll("[data-direct-download]")) {
        el.addEventListener("click", () => {
          toast.hidden = false;
          if (toastTimer) clearTimeout(toastTimer);
          toastTimer = setTimeout(() => {
            toast.hidden = true;
          }, 9000);
        });
      }
      for (const btn of toast.querySelectorAll("[data-toast-close]")) {
        btn.addEventListener("click", () => {
          toast.hidden = true;
        });
      }
    }
  })();
</script>
