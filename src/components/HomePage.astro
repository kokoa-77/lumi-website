    </p>
    <h2 class="mt-3 text-4xl font-black tracking-[-0.035em] text-[var(--fg)] sm:text-5xl">
      {d.title}
    </h2>
    <p class="mt-3 text-sm text-[var(--fg-muted)] sm:text-base">{d.subtitle}</p>

    <!-- Release Channel Pill -->
    <div class="mt-7 flex flex-col items-center gap-2">
      <div
        class="lumi-glass lumi-pill lumi-tabular inline-flex items-center gap-2.5 px-5 py-2 text-xs font-semibold text-[var(--fg)] sm:text-sm"
