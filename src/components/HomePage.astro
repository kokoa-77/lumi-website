<!-- Top ultra-thin luminous scroll progress line -->
<div id="lumi-scroll-progress" class="lumi-scroll-progress" aria-hidden="true"></div>

<!-- Interactive bottom micro-toast for ecosystem capsules -->
<div
  id="lumi-eco-toast"
  role="status"
  aria-live="polite"
  data-visible="false"
  class="lumi-eco-toast lumi-glass lumi-pill max-w-[90vw] px-4 py-2 text-xs font-semibold text-[var(--fg)] shadow-lg"
>
</div>

<!-- =================================================================
     1. CINEMATIC SKY-LIGHT HERO + DIRECT DOWNLOAD + COLOR-LOCKED 3D STAGE
     ================================================================= -->
<section class="lumi-sky -mt-[68px] overflow-x-clip pb-16 pt-28 sm:pb-24 sm:pt-32">
  <div class="lumi-aurora-orb lumi-aurora-a" aria-hidden="true"></div>
  <div class="lumi-aurora-orb lumi-aurora-b" aria-hidden="true"></div>
  <div class="lumi-dot-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    {
      motes.map((m) => (
        <span
          class="lumi-mote"
          style={`top:${m.top};left:${m.left};width:${m.size}px;height:${m.size}px;--dur:${m.dur};--delay:${m.delay};--dx:${m.dx};--dy:${m.dy};`}
        />
      ))
    }
  </div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-3xl text-center">
