const installerHref = primaryDownloadHref(latest.installer, latest.htmlUrl);
const portableHref = primaryDownloadHref(latest.portable, latest.htmlUrl);
const installerUsesSite = Boolean(latest.installer?.sitePath);
const portableUsesSite = Boolean(latest.portable?.sitePath);
const installerName = latest.installer?.name || "Lumi_0.6.0_x64-setup.exe";
const portableName = latest.portable?.name || "Lumi_0.6.0_x64-portable.zip";
const installerSize = latest.installer ? formatBytes(latest.installer.size) : "9.8 MB";
const portableSize = latest.portable ? formatBytes(latest.portable.size) : "";
const checksumsHref = latest.checksumsSitePath || latest.checksumsUrl;

const kindLabel = t.releaseKind[latest.kind];
const heroNote =
  latest.kind === "prereview"
    ? h.heroNotePrereview
