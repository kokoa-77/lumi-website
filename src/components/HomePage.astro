          <span class="flex items-center gap-2.5">
            <span class="lumi-acc-arrow inline-block text-[10px] text-[var(--accent)]">▶</span>
            {d.smartScreenTitle}
          </span>
          <span class="text-[11px] font-normal text-[var(--fg-muted)]">
            {isZh ? "两步图解" : "2-step guide"}
          </span>
        </button>

        <div class="lumi-acc-body">
          <div class="lumi-acc-inner">
            <div class="mt-3.5 grid items-center gap-5 border-t border-[var(--line)] pt-4 sm:grid-cols-12">
              <div class="sm:col-span-6">
                <svg
                  viewBox="0 0 540 310"
                  class="w-full rounded-xl border border-[var(--line)] shadow-sm"
                  role="img"
                  aria-label={d.smartScreenTitle}
                >
                  <rect width="540" height="310" rx="10" fill="#005A9E" />
                  <rect x="0" y="0" width="540" height="36" fill="#004578" />
                  <text x="20" y="23" fill="#DCEEFF" font-size="13" font-family="system-ui, sans-serif">
                    Microsoft Defender SmartScreen
                  </text>
                  <text x="28" y="78" fill="#FFFFFF" font-size="22" font-weight="700" font-family="system-ui, sans-serif">
                    {isZh ? "Windows 已保护你的电脑" : "Windows protected your PC"}
                  </text>
                  <text x="28" y="110" fill="#E3F2FD" font-size="13" font-family="system-ui, sans-serif">
                    {isZh
                      ? "Microsoft Defender SmartScreen 阻止了无法识别的应用启动。"
                      : "Microsoft Defender SmartScreen prevented an unrecognized app."}
                  </text>
                  <rect x="22" y="128" width="104" height="30" rx="6" fill="#FFFFFF" fill-opacity="0.16" stroke="#FFD54F" stroke-width="2" />
                  <text x="34" y="148" fill="#FFFFFF" font-size="14" font-weight="700" text-decoration="underline" font-family="system-ui, sans-serif">
                    {isZh ? "更多信息" : "More info"}
                  </text>
                  <circle cx="144" cy="143" r="12" fill="#FFD54F" />
                  <text x="144" y="148" text-anchor="middle" fill="#1B2A4A" font-size="13" font-weight="800" font-family="system-ui, sans-serif">1</text>
                  <text x="28" y="186" fill="#CFE8FF" font-size="12" font-family="monospace">
                    {isZh ? `应用: ${installerName}` : `App: ${installerName}`}
                  </text>
                  <text x="28" y="206" fill="#CFE8FF" font-size="12" font-family="system-ui, sans-serif">
                    {isZh ? "发布者: 未知发布者" : "Publisher: Unknown publisher"}
                  </text>
                  <rect x="230" y="246" width="136" height="38" rx="4" fill="#FFFFFF" fill-opacity="0.22" stroke="#FFD54F" stroke-width="2.2" />
                  <text x="298" y="270" text-anchor="middle" fill="#FFFFFF" font-size="14" font-weight="700" font-family="system-ui, sans-serif">
                    {isZh ? "仍要运行" : "Run anyway"}
                  </text>
                  <circle cx="212" cy="265" r="12" fill="#FFD54F" />
                  <text x="212" y="270" text-anchor="middle" fill="#1B2A4A" font-size="13" font-weight="800" font-family="system-ui, sans-serif">2</text>
                  <rect x="382" y="246" width="130" height="38" rx="4" fill="#FFFFFF" fill-opacity="0.1" stroke="#FFFFFF" stroke-opacity="0.45" />
                  <text x="447" y="270" text-anchor="middle" fill="#DCEEFF" font-size="14" font-family="system-ui, sans-serif">
                    {isZh ? "不运行" : "Don't run"}
                  </text>
                </svg>
              </div>
              <div class="space-y-2.5 text-xs leading-relaxed text-[var(--fg-muted)] sm:col-span-6">
                <p class="font-semibold text-[var(--fg)]">{d.smartScreenStep1}</p>
                <p class="font-semibold text-[var(--fg)]">{d.smartScreenStep2}</p>
                <p>{d.smartScreenWhyBody}</p>
                <a
                  href={LINKS.issues}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block font-semibold text-[var(--accent)] hover:underline"
                >
                  {d.smartScreenFalsePositive} ↗
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <p class="mt-9 text-xs leading-relaxed text-[var(--fg-muted)]">
      {isZh ? "Lumi 基于 " : "Lumi is free software under "}
      <a href={LINKS.license} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-[var(--fg)]">
        GPL-3.0-only
      </a>
      {isZh ? " 开源免费 · 仅支持 Windows 10/11 (x64) 与正版 Microsoft 账户 · " : " · Windows 10/11 (x64) + official Microsoft account · "}
      <a href={LINKS.releases} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-[var(--fg)]">
        {isZh ? "历史版本" : "All Releases"}
      </a>
      {" · "}
      <a href={privacyHref} class="underline underline-offset-4 hover:text-[var(--fg)]">
        {t.nav.privacy}
      </a>
      {" · "}
      <a href={checksumsHref} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-[var(--fg)]">
        {isZh ? "校验清单" : "Checksums"}
      </a>
    </p>
  </div>
</section>

<!-- =================================================================
     6. ASYMMETRIC STICKY-LEFT EDITORIAL FAQ (#faq)
     ================================================================= -->
<section id="faq" class="lumi-reveal mx-auto max-w-6xl scroll-mt-24 px-4 py-16 sm:px-6 sm:py-24">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-28">
        <p class="text-xs font-bold tracking-[0.16em] text-[var(--accent)] uppercase">
          {isZh ? "常见问题" : "FAQ"}
        </p>
        <h2
          class="lumi-balance mt-3 text-3xl font-black tracking-[-0.03em] text-[var(--fg)] sm:text-4xl lg:leading-[1.15]"
        >
          {
            isZh ? (
              <>
                关于 Lumi，
                <span class="inline-block">你需要了解的一切</span>
              </>
            ) : (
              "Everything you should know about Lumi"
            )
          }
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--fg-muted)]">
          {h.faqSubtitle}
        </p>
      </div>
    </div>

    <div class="space-y-3 lg:col-span-8">
      {
        h.faqs.map((item, idx) => (
          <div
            class="lumi-acc-item rounded-2xl bg-[var(--surface)] px-5 py-4 shadow-xs transition-colors hover:bg-[var(--overlay)]"
            data-open={idx === 0 ? "true" : "false"}
          >
            <button
              type="button"
              data-acc-trigger
              aria-expanded={idx === 0 ? "true" : "false"}
              class="flex w-full cursor-pointer items-center gap-3 text-left text-sm font-bold text-[var(--fg)] sm:text-[15px]"
            >
              <span class="lumi-acc-arrow inline-block shrink-0 text-[10px] text-[var(--accent)]">
                ▶
              </span>
              <span>{item.q}</span>
            </button>
            <div class="lumi-acc-body">
              <div class="lumi-acc-inner">
                <p class="pt-3 pl-5 text-sm leading-relaxed text-[var(--fg-muted)]">{item.a}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

