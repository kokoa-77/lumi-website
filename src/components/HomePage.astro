<!-- =================================================================
     5. CLEAN PLAYER-FRIENDLY INLINE DOWNLOAD SECTION (#download)
     ================================================================= -->
<section id="download" class="lumi-reveal relative scroll-mt-24 py-20 sm:py-28">
  <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
    <p class="text-xs font-bold tracking-[0.16em] text-[var(--accent)] uppercase">
