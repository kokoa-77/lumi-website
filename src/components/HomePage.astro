        <span>{latest.tag}</span>
        <span class="opacity-30">|</span>
        <span class="text-[var(--accent)]">{kindLabel}</span>
        <span class="opacity-30">|</span>
        <span class="font-normal text-[var(--fg-muted)]">{formatDate(latest.publishedAt, locale)}</span>
