          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Lean interactive runtime (~4 KiB gzip): Color-locked stage + 3D sheen + All 4 Bento widgets + Eco toast + Scroll bar -->
<script is:inline>
  (() => {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fine = window.matchMedia("(pointer: fine)").matches;

    // 1. Top luminous scroll progress bar
    const progressBar = document.getElementById("lumi-scroll-progress");
    if (progressBar) {
      let ticking = false;
      const updateBar = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - window.innerHeight;
        const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
        progressBar.style.transform = `scaleX(${ratio.toFixed(4)})`;
        ticking = false;
      };
      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(updateBar);
          }
        },
        { passive: true },
      );
      updateBar();
    }

    // 2. Adaptive color-locked showcase tabs (syncs caption & spotlight smoothly across light/dark)
    const tabs = Array.from(document.querySelectorAll("[data-showcase-tab]"));
    const panels = Array.from(document.querySelectorAll("[data-showcase-panel]"));
    const captionEl = document.getElementById("lumi-showcase-caption");
    const syncActiveCaption = () => {
      if (!captionEl) return;
      const activeTab = tabs.find((t) => t.getAttribute("aria-selected") === "true") || tabs[0];
      if (!activeTab) return;
      const isDark = document.documentElement.dataset.theme === "dark";
      captionEl.textContent = isDark
        ? activeTab.dataset.captionDark || activeTab.dataset.caption || ""
        : activeTab.dataset.caption || "";
    };
    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        const id = tab.getAttribute("data-showcase-tab");
        const root = document.documentElement;
        if (tab.dataset.hue) root.style.setProperty("--accent-h", tab.dataset.hue);
        if (tab.dataset.lightL) root.style.setProperty("--accent-l-light", tab.dataset.lightL);
        if (tab.dataset.lightC) root.style.setProperty("--accent-c-light", tab.dataset.lightC);
        if (tab.dataset.darkL) root.style.setProperty("--accent-l-dark", tab.dataset.darkL);
        if (tab.dataset.darkC) root.style.setProperty("--accent-c-dark", tab.dataset.darkC);

        for (const btn of tabs) {
          const active = btn === tab;
          btn.setAttribute("aria-selected", active ? "true" : "false");
          btn.classList.toggle("bg-[var(--accent)]", active);
          btn.classList.toggle("text-[var(--on-accent)]", active);
          btn.classList.toggle("text-[var(--fg-muted)]", !active);
        }
        for (const panel of panels) {
          const show = panel.getAttribute("data-showcase-panel") === id;
          panel.classList.toggle("opacity-100", show);
          panel.classList.toggle("opacity-0", !show);
          panel.classList.toggle("pointer-events-none", !show);
        }
        syncActiveCaption();
      });
    }

    // 3. Spotlight 01 Day/Night inline preview toggle (follows page theme automatically + allows manual flip)
    const spotBtns = Array.from(document.querySelectorAll("[data-spot-toggle]"));
    const spotPanels = Array.from(document.querySelectorAll("[data-spot-theme]"));
    const applySpotTheme = (target) => {
      for (const b of spotBtns) {
        const on = b.getAttribute("data-spot-toggle") === target;
        b.setAttribute("aria-pressed", on ? "true" : "false");
        b.classList.toggle("bg-[var(--accent)]", on);
        b.classList.toggle("text-[var(--on-accent)]", on);
        b.classList.toggle("text-[var(--fg-muted)]", !on);
      }
      for (const p of spotPanels) {
        const show = p.getAttribute("data-spot-theme") === target;
        p.classList.toggle("opacity-100", show);
        p.classList.toggle("opacity-0", !show);
        p.classList.toggle("pointer-events-none", !show);
      }
    };
    for (const btn of spotBtns) {
      btn.addEventListener("click", () => {
        const target = btn.getAttribute("data-spot-toggle");
        if (target) applySpotTheme(target);
      });
    }
    const syncThemeAwarePreviews = () => {
      const mode = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      applySpotTheme(mode);
      syncActiveCaption();
    };
    syncThemeAwarePreviews();
    new MutationObserver(syncThemeAwarePreviews).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });

    // 3b. Mobile Hero "Copy clean link to open on PC" with Bilibili/in-app WebView fallback
    const mobileCopyBtn = document.getElementById("lumi-mobile-copy-link");
    const mobileFallback = document.getElementById("lumi-mobile-copy-fallback");
    const mobileInput = document.getElementById("lumi-mobile-copy-input");
    if (mobileCopyBtn) {
      const span = mobileCopyBtn.querySelector("span");
      const origLabel = span?.textContent || "";
      mobileCopyBtn.addEventListener("click", async () => {
        const cleanUrl = `${window.location.origin}${window.location.pathname}`;
        let ok = false;
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(cleanUrl);
            ok = true;
          }
        } catch {
          ok = false;
        }
        if (!ok) {
          try {
            const ta = document.createElement("textarea");
            ta.value = cleanUrl;
            ta.setAttribute("readonly", "");
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            ok = document.execCommand("copy");
            ta.remove();
          } catch {
            ok = false;
          }
        }
        if (ok) {
          if (mobileFallback) mobileFallback.hidden = true;
          if (span) span.textContent = mobileCopyBtn.dataset.copiedLabel || "Copied";
          window.setTimeout(() => {
            if (span) span.textContent = origLabel;
          }, 2400);
        } else if (mobileFallback && mobileInput) {
          mobileInput.value = cleanUrl;
          mobileFallback.hidden = false;
          mobileInput.focus();
          mobileInput.select();
        }
      });
    }

    // 4. Pointer-driven 3D tilt + specular glass sheen + bento cursor spotlight glow
    const stage = document.getElementById("lumi-3d-stage");
    if (stage && !reduced && fine) {
      stage.addEventListener("pointermove", (e) => {
        const r = stage.getBoundingClientRect();
        const rxPct = (e.clientX - r.left) / r.width;
        const ryPct = (e.clientY - r.top) / r.height;
        stage.style.setProperty("--ry", `${((rxPct - 0.5) * 4.5).toFixed(2)}deg`);
        stage.style.setProperty("--rx", `${(-(ryPct - 0.5) * 3.5).toFixed(2)}deg`);
        stage.style.setProperty("--sx", `${(rxPct * 100).toFixed(1)}%`);
        stage.style.setProperty("--sy", `${(ryPct * 100).toFixed(1)}%`);
      });
      stage.addEventListener("pointerleave", () => {
        stage.style.setProperty("--ry", "0deg");
        stage.style.setProperty("--rx", "0deg");
      });
    }

    if (!reduced && fine) {
      for (const card of document.querySelectorAll(".lumi-bento-card")) {
        card.addEventListener("pointermove", (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${(e.clientX - r.left).toFixed(0)}px`);
          card.style.setProperty("--my", `${(e.clientY - r.top).toFixed(0)}px`);
        });
      }
    }

    // 5. Bento 02 Live Rollback Widget
    const rbBox = document.getElementById("lumi-rollback-widget");
    const rbBtn = document.getElementById("lumi-rollback-btn");
    if (rbBox && rbBtn) {
      const rbDot = rbBox.querySelector("[data-rb-dot]");
      const rbTitle = rbBox.querySelector("[data-rb-title]");
      const rbDetail = rbBox.querySelector("[data-rb-detail]");
      rbBtn.addEventListener("click", () => {
        const isBroken = rbBox.dataset.state === "broken";
        rbBox.dataset.state = isBroken ? "ok" : "broken";
        if (rbTitle) rbTitle.textContent = isBroken ? rbBtn.dataset.titleOk || "" : rbBtn.dataset.titleBroken || "";
        if (rbDetail) rbDetail.textContent = isBroken ? rbBtn.dataset.detailOk || "" : rbBtn.dataset.detailBroken || "";
        rbBtn.textContent = isBroken ? rbBtn.dataset.labelReset || "" : rbBtn.dataset.labelRevert || "";
        if (rbDot) {
          rbDot.classList.toggle("bg-[var(--warning)]", !isBroken);
          rbDot.classList.toggle("bg-[var(--accent)]", isBroken);
        }
        rbBtn.classList.toggle("bg-[var(--accent)]", !isBroken);
        rbBtn.classList.toggle("text-[var(--on-accent)]", !isBroken);
        rbBtn.classList.toggle("bg-[var(--surface)]", isBroken);
        rbBtn.classList.toggle("text-[var(--fg)]", isBroken);
        rbBtn.classList.toggle("border", isBroken);
        rbBtn.classList.toggle("border-[var(--line)]", isBroken);
      });
    }

    // 6. Bento 03 Live Discover Scenario Widget
    const discTabs = Array.from(document.querySelectorAll("[data-disc-tab]"));
    const discBadge = document.getElementById("lumi-disc-badge");
    const discTitle = document.getElementById("lumi-disc-title");
    const discDetail = document.getElementById("lumi-disc-detail");
    for (const tab of discTabs) {
      tab.addEventListener("click", () => {
        for (const t of discTabs) {
          const on = t === tab;
          t.setAttribute("aria-selected", on ? "true" : "false");
          t.classList.toggle("bg-[var(--accent)]", on);
          t.classList.toggle("text-[var(--on-accent)]", on);
          t.classList.toggle("border", !on);
          t.classList.toggle("border-[var(--line)]", !on);
          t.classList.toggle("bg-[var(--surface-2)]", !on);
          t.classList.toggle("text-[var(--fg-muted)]", !on);
        }
        if (discBadge && tab.dataset.discBadge) discBadge.textContent = tab.dataset.discBadge;
        if (discTitle && tab.dataset.discTitle) discTitle.textContent = tab.dataset.discTitle;
        if (discDetail && tab.dataset.discDetail) discDetail.textContent = tab.dataset.discDetail;
      });
    }

    // 7. Bento 04 Real Lumi SessionPipe & Log Redaction Inspector
    const redactBtn = document.getElementById("lumi-redact-btn");
    const redactCmd = document.getElementById("lumi-redact-cmd");
    const redactLog = document.getElementById("lumi-redact-log");
    if (redactBtn && redactCmd && redactLog) {
      redactBtn.addEventListener("click", () => {
        const nextPipe = redactBtn.dataset.mode === "proc";
        redactBtn.dataset.mode = nextPipe ? "pipe" : "proc";
        redactBtn.textContent = nextPipe ? redactBtn.dataset.labelPipe || "" : redactBtn.dataset.labelProc || "";
        redactCmd.textContent = nextPipe ? redactBtn.dataset.cmdPipe || "" : redactBtn.dataset.cmdProc || "";
        redactLog.textContent = nextPipe ? redactBtn.dataset.logPipe || "" : redactBtn.dataset.logProc || "";
      });
    }

    // 8. Bento 05 Live Cross-Instance Sync Switch Widget
    const syncSwitches = Array.from(document.querySelectorAll("[data-sync-toggle]"));
    const syncCounter = document.getElementById("lumi-sync-counter");
    if (syncSwitches.length > 0) {
      const isZhDoc = document.documentElement.lang.startsWith("zh");
      const updateSyncCounter = () => {
        const n = syncSwitches.filter((b) => b.getAttribute("aria-checked") === "true").length;
        if (syncCounter) {
          const tpl = isZhDoc ? syncCounter.dataset.tplZh : syncCounter.dataset.tplEn;
          if (tpl) syncCounter.textContent = tpl.replace("{n}", String(n));
        }
      };
      for (const sw of syncSwitches) {
        sw.addEventListener("click", () => {
          const next = sw.getAttribute("aria-checked") !== "true";
          sw.setAttribute("aria-checked", next ? "true" : "false");
          const track = sw.querySelector(".lumi-switch");
          if (track) track.setAttribute("aria-checked", next ? "true" : "false");
          updateSyncCounter();
        });
      }
    }

    // 9. Clickable Ecosystem Wall Toast Feedback
    const ecoToast = document.getElementById("lumi-eco-toast");
    let toastTimer = 0;
    if (ecoToast) {
      for (const pill of document.querySelectorAll("[data-eco-tip]")) {
        pill.addEventListener("click", () => {
          const tip = pill.getAttribute("data-eco-tip");
          if (!tip) return;
          ecoToast.textContent = tip;
          ecoToast.dataset.visible = "true";
          window.clearTimeout(toastTimer);
          toastTimer = window.setTimeout(() => {
            ecoToast.dataset.visible = "false";
          }, 3200);
        });
      }
    }

    // 10. Choreographed scroll reveals + instant hash-jump reveal
    const reveals = Array.from(document.querySelectorAll(".lumi-reveal"));
    const revealAll = () => {
      for (const el of reveals) el.classList.add("is-visible");
    };
    if (reveals.length > 0 && "IntersectionObserver" in window && !reduced) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.06, rootMargin: "0px 0px -30px 0px" },
      );
      for (const el of reveals) io.observe(el);
      if (window.location.hash) revealAll();
      window.addEventListener("hashchange", revealAll);
    } else {
      revealAll();
    }

    // 11. Smooth CSS Grid Accordions (FAQ + SmartScreen drawer)
    for (const trigger of document.querySelectorAll("[data-acc-trigger]")) {
      trigger.addEventListener("click", () => {
        const item = trigger.closest(".lumi-acc-item");
        if (!item) return;
        const next = item.getAttribute("data-open") !== "true";
        item.setAttribute("data-open", next ? "true" : "false");
        trigger.setAttribute("aria-expanded", next ? "true" : "false");
      });
    }
  })();
</script>
