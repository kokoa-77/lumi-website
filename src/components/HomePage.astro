        </svg>
        <h3 class="mt-4 text-2xl font-bold text-[var(--fg)]">{d.installerTitle}</h3>
        <p class="lumi-tabular mt-1.5 text-xs text-[var(--fg-muted)]">
          {installerName} · {installerSize}
        </p>

        <a
          href={installerHref}
          download={installerName}
          data-direct-download={installerName}
          class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-[var(--accent)] no-underline transition-opacity hover:opacity-80 sm:text-base"
        >
          <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5M5 19h14"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          {isZh ? "下载安装程序（推荐）" : "Download Installer (Recommended)"}
        </a>

        <p class="mt-2 text-xs text-[var(--fg-muted)]">
          {isZh ? "支持签名自动更新与 .mrpack 整合包关联" : "Signed auto-updates & .mrpack file association"}
        </p>

        {
          latest.installer && installerUsesSite && (
            <a
              href={latest.installer.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 text-[11px] text-[var(--fg-muted)] underline decoration-[var(--line)] underline-offset-4 hover:text-[var(--fg)]"
            >
              {d.btnFallbackGithub} ↗
            </a>
