---
import PressPage from "../../components/PressPage.astro";
import { getDict } from "../../data/i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";

const t = getDict("zh");
---

<BaseLayout
  locale="zh"
  title={t.press.metaTitle}
  description={t.press.metaDesc}
  routePath="/press"
  noindex={true}
>
  <PressPage locale="zh" />
</BaseLayout>
