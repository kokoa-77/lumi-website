---
import ChangelogPage from "../components/ChangelogPage.astro";
import { getDict } from "../data/i18n";
import BaseLayout from "../layouts/BaseLayout.astro";

const t = getDict("en");
---

<BaseLayout
  locale="en"
  title={t.changelog.metaTitle}
  description={t.changelog.metaDesc}
  routePath="/changelog"
>
  <ChangelogPage locale="en" />
</BaseLayout>
